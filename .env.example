# ============================================================
# Document Extraction Pipeline — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your Azure resource values.
# NEVER commit .env to source control.
# ============================================================

# --- Azure Content Understanding ---
CU_ENDPOINT=https://cu-docextract-<suffix>.cognitiveservices.azure.com
CU_ANALYZER_NAME=document-analyzer
# CU_KEY=           # Optional: leave empty to use DefaultAzureCredential

# --- Azure AI Foundry / OpenAI ---
FOUNDRY_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
FOUNDRY_MODEL=gpt-4.1
FOUNDRY_TENANT_ID=<your-tenant-id>

# --- Azure Cosmos DB ---
COSMOS_ENDPOINT=https://cosmos-docextract-<suffix>.documents.azure.com:443
COSMOS_DATABASE=documents
COSMOS_CONTAINER=extractions
# COSMOS_KEY=       # Optional: leave empty to use DefaultAzureCredential

# --- Azure Blob Storage ---
STORAGE_ACCOUNT_URL=https://stdocextract<suffix>.blob.core.windows.net
# STORAGE_CONNECTION_STRING=  # Alternative to account URL + credential

# --- Application Insights ---
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/

# --- Pipeline Behavior ---
CONFIDENCE_AUTO_ACCEPT=0.85
CONFIDENCE_AGENT_THRESHOLD=0.60
LOW_CONFIDENCE_THRESHOLD=0.70
ENABLE_AI_MAPPER=true
ENABLE_AGENT_REVIEW=true
MAX_RETRIES=3
